rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Avatars: world-readable (profile thumbnails), owner-only writes with a
    // hard size + content-type guard so nothing huge or non-image can land.
    match /users/{userId}/avatar {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Board documents offloaded by the web app (documents/{uid}/{boardId}/...):
    // strictly owner-scoped read/write.
    match /documents/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId
        && request.resource.size < 25 * 1024 * 1024;
    }

    // Default fallback rule: deny everything else (no data exfiltration).
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
